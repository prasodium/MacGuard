# Everything below is OPTIONAL: you can configure Brevo and your Gmail from the app (Settings -> Email).
# Copy to .env (never commit) and export before `npm start`, or set in your host's secret manager.
EMAIL_PROVIDER=brevo            # brevo | resend | console
BREVO_API_KEY=                  # Brevo key (or paste it in the app instead)
RESEND_API_KEY=                 # only if EMAIL_PROVIDER=resend
OWNER_EMAIL=                    # trusted bootstrap recipient (no verification step); prefer verifying your Gmail in the app
FROM_EMAIL="MacGuard <you@example.com>"   # Brevo: must be a sender verified in your Brevo account
PORT=8787
DATA_DIR=./data                 # persistent: holds the saved key and verified recipient (mode 0600)
CONFIG_RATE_LIMIT_PER_HOUR=20   # set 0 to forbid in-app configuration
